rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 헬퍼 함수: 관리자 여부 확인
    // 단순히 "로그인 되어 있으면 관리자"가 아니라, admins 컬렉션에
    // 본인 UID로 된 문서가 실제로 존재하는 사람만 관리자로 인정합니다.
    // Firebase Authentication에 계정이 새로 하나 생기더라도, admins 컬렉션에
    // 등록돼 있지 않으면 자동으로 관리자 권한을 갖지 못합니다.
    //
    // ⚠️ 배포 전 필수 작업: Firebase 콘솔 → Firestore Database →
    //    'admins' 컬렉션 생성 → 원장님 계정의 UID를 문서 ID로 문서 추가
    //    (Authentication 탭에서 UID 확인 가능, 문서 내용은 { email: "..." } 등 자유)
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 헬퍼 함수: 승인된 수강생 여부 확인
    function isApprovedStudent() {
      return request.auth != null
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == '승인됨';
    }

    // 0. 관리자 목록('admins') - 관리자 본인만 자기 문서를 읽을 수 있고,
    // 쓰기는 Firebase 콘솔에서 직접 등록/삭제 (클라이언트에서 쓰기 불가)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 1. 공지사항('notices') & 인기강좌('popular_courses')
    // 누구나 읽기 가능, 관리자만 쓰기(생성/수정/삭제) 가능
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /popular_courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. 개강 팝업 등 사이트 설정('settings')
    // 누구나 읽기 가능, 관리자만 쓰기 가능
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. 수강신청('applications') - 이름/전화번호 등 개인정보 포함
    // 누구나 작성(create)만 가능, 조회/수정/삭제는 관리자만 (개인정보 보호 핵심 규칙)
    // create 시 최소한의 형식/길이 검증을 추가해 비정상적으로 크거나 형식이
    // 어긋난 스팸성 데이터가 저장되는 것을 서버(Firestore) 단에서도 막습니다.
    match /applications/{applicationId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9
        && request.resource.data.phone.size() <= 20
        && (!('message' in request.resource.data) || request.resource.data.message.size() <= 1000);
      allow read, update, delete: if isAdmin();
    }

    // 4. 접수번호 카운터('counters') - 수강신청 접수번호(YYMM-N) 발급용
    // 익명 사용자도 접수번호를 발급받아야 하므로 읽기/생성/증가(update)를 허용하되,
    // "이전 값 + 1"로만 증가할 수 있도록 제한해 임의 조작이나 되돌리기를 막습니다.
    // (applications 컬렉션 자체는 읽기가 막혀 있어 신청자 수를 세는 용도로 쓸 수
    //  없기 때문에, 이 전용 카운터로 원자적(transaction)으로 채번합니다.)
    //
    // ⚠️ 알려진 한계: update가 인증 없이 열려 있어, 악의적인 사용자가 반복
    //    호출로 카운터 숫자 자체를 임의로 늘릴 수는 있습니다(개인정보 유출은
    //    아니고, 접수번호가 듬성듬성해지는 정도의 영향). 완전히 막으려면
    //    서버(예: Vercel 서버리스 함수 + Firebase Admin SDK)에서만 채번하도록
    //    구조를 바꿔야 하는데, 이는 별도 서비스 계정 키 발급이 필요한 큰 변경이라
    //    지금 학원 홈페이지 규모에서는 아래 정도의 형식/범위 제한으로 위험을
    //    줄이는 선에서 우선 반영했습니다.
    match /counters/{counterId} {
      allow read: if true;
      allow create: if counterId.matches('^[0-9]{4}$')
        && request.resource.data.count == 1;
      allow update: if counterId.matches('^[0-9]{4}$')
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 999999;
      allow delete: if isAdmin();
    }

    // 5. 자료실 메타데이터('materials') - 서식/예제/채점프로그램 등 다운로드 목록
    // 실제 파일은 Storage(materials/)에 있고, 여기에는 제목·설명·분류·파일경로
    // 같은 메타데이터만 저장합니다. 재원생(승인된 수강생) 또는 관리자만 조회
    // 가능하며, 쓰기(업로드 기록 생성/삭제)는 관리자만 가능합니다.
    //
    // ⚠️ '학원서식' 유형은 학원 내부용 서류 성격이라, 승인된 수강생이어도
    // 볼 수 없고 관리자만 조회 가능하도록 별도로 막았습니다. Firestore는
    // 쿼리(list) 결과에서도 문서 하나하나에 이 규칙을 적용해 걸러내므로,
    // 수강생이 자료 목록을 구독해도 '학원서식' 문서는 애초에 목록에
    // 포함되지 않습니다(따로 필터링할 필요 없이 서버 단에서 걸러집니다).
    match /materials/{materialId} {
      allow read: if isAdmin()
        || (isApprovedStudent() && resource.data.materialType != '학원서식');
      allow create, delete: if isAdmin();
      // 다운로드 횟수 집계: 승인된 수강생도 downloadCount 필드'만' +1 증가시키는
      // 업데이트는 예외적으로 허용합니다(다른 필드를 같이 바꾸려는 시도는 막습니다).
      // 그 외 모든 필드 수정은 관리자만 가능합니다.
      allow update: if isAdmin()
        || (
          isApprovedStudent()
          && resource.data.materialType != '학원서식'
          && request.resource.data.downloadCount == resource.data.downloadCount + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount'])
        );
    }

    // 6. 수강생 계정('students') - 자료실 이용을 위한 회원가입/승인 정보
    // 누구나 회원가입(create)은 가능하지만 status는 반드시 '승인대기'로만
    // 시작할 수 있습니다(가입 시 스스로 '승인됨'으로 만들 수 없도록 방지).
    // 본인 문서는 본인이 읽을 수 있고, 관리자는 전체 조회/승인(update) 가능합니다.
    // 승인 상태 변경(update)은 관리자만 가능해 수강생 스스로 승인 처리할 수 없습니다.
    match /students/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == '승인대기'
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        // 010-9079-1234, 033-433-1926처럼 하이픈 포함, 끝자리까지 온전히
        // 입력된 형식만 허용합니다. 프론트엔드 검증을 우회해도 서버(Firestore)
        // 단에서 한 번 더 막습니다.
        && request.resource.data.phone.matches('^0[0-9]{1,2}-[0-9]{3,4}-[0-9]{4}$')
        && request.resource.data.email is string;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow update, delete: if isAdmin();
    }

  }
}
