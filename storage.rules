rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // 헬퍼 함수: 관리자 여부 확인
    // ⚠️ 이전 버전은 Firestore의 admins 컬렉션을 조회하는 방식(firestore.exists())을
    // 썼는데, 이 방식은 Firebase 콘솔에서 "두 서비스 연결 권한"을 별도로 한 번 더
    // 승인해야만 정상 작동합니다. 이 승인 단계를 놓치면 모든 업로드/삭제 요청이
    // 조용히 거부되어(화면에는 별다른 오류 없이 0%에서 멈춘 것처럼 보임) 원인을
    // 찾기 어려워지는 문제가 있었습니다.
    // 지금은 대신 로그인한 계정의 이메일을 직접 확인하는 방식으로 바꿨습니다.
    // 추가 설정 없이 즉시 작동하고, 이 프로젝트는 관리자 계정이 1개뿐이라 이
    // 방식으로 충분합니다. 나중에 관리자 계정을 추가하실 경우, 아래 목록에
    // 이메일 주소를 한 줄 더 추가하고 다시 게시(Publish)하시면 됩니다.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'jiho1234@jahrd.co.kr'
        ];
    }

    function isAllowedImage() {
      return request.resource.size < 10 * 1024 * 1024 // 10MB 이하
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    // 1. 활동사진 파일 Storage 경로 ('activities/')
    // 누구나 이미지 조회(read) 가능, 관리자만 업로드 및 삭제(write) 가능
    // 업로드는 10MB 이하의 JPEG/PNG/WebP 이미지로 제한합니다.
    match /activities/{allPaths=**} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && isAllowedImage();
    }

    // 2. 공지사항 첨부 파일 Storage 경로 ('notices/')
    // 이미지 외에 PDF 첨부도 허용하되, 크기 제한은 동일하게 적용합니다.
    match /notices/{allPaths=**} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/(jpeg|jpg|png|webp)')
            || request.resource.contentType == 'application/pdf');
    }

    // 3. 자료실 파일 Storage 경로 ('materials/') - 서식/예제/채점프로그램 등
    // 로그인한 사용자(승인된 수강생 또는 관리자)만 다운로드(read) 가능,
    // 업로드/삭제는 관리자만 가능합니다.
    //
    // ⚠️ 설계 노트: Storage 규칙에서 Firestore의 승인 상태(students/{uid}.status)
    // 까지 직접 조회(firestore.exists())하는 방법도 있지만, 이 cross-service
    // 조회는 Firebase 콘솔에서 별도의 "두 서비스 연결 권한"을 승인해야만
    // 동작하고, 이 승인 단계를 놓치면 오류 메시지 없이 조용히 요청이 거부되는
    // 문제가 있었습니다(실제로 자료실 업로드 기능 구축 중 겪었던 문제입니다).
    // 그래서 여기서는 "로그인 여부"만 확인하고, 실제 승인 여부는 Firestore의
    // materials 컬렉션 읽기 권한(승인된 수강생만 목록 조회 가능)에서 걸러냅니다.
    // 즉 승인되지 않은 계정은 애초에 파일 목록/URL 자체를 볼 수 없으므로,
    // 이 Storage 규칙까지 도달할 일이 없습니다.
    // 3. 자료실 파일 Storage 경로 ('materials/') - 서식/예제/채점프로그램 등
    // 관리자 또는 "승인된 수강생"만 다운로드(read) 가능, 업로드/삭제는 관리자만.
    //
    // ⚠️ 설계 변경 이력: 처음에는 Storage 규칙에서 Firestore의 승인 상태를
    // 직접 조회(firestore.exists())하려 했으나, 이 cross-service 조회는
    // Firebase 콘솔에서 별도의 "두 서비스 연결 권한" 승인이 필요하고, 이
    // 단계를 놓치면 오류 메시지 없이 조용히 전부 막혀버리는 문제를 실제로
    // 겪었습니다. 그다음엔 임시로 "로그인 여부만" 확인하는 느슨한 규칙으로
    // 대체했었는데, 승인되지 않은 계정도 파일 URL만 알면 이론적으로 접근할
    // 수 있는 허점이 있었습니다.
    // 지금은 Custom Claims(로그인 토큰 자체에 담기는 승인 정보)를 사용합니다.
    // 관리자가 수강생을 승인/거절할 때 api/set-student-approval.ts가
    // Firebase Authentication 토큰에 approved: true/false를 심어주고,
    // 이 규칙은 그 값을 바로 확인합니다 - Firestore 재조회가 필요 없어
    // 콘솔 추가 승인 단계 없이도 안전하게 작동합니다.
    match /materials/{allPaths=**} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.approved == true);
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && request.resource.size < 100 * 1024 * 1024;
    }

  }
}
